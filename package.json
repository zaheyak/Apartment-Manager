{
  "name": "apartment-manager",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.2.5",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "node -e \"console.log('Backend requires no compilation')\"",
    "build:frontend": "npm --workspace apartment-manager-web run build",
    "dev": "npm --workspace apartment-manager-web run dev",
    "start": "npm --workspace apartment-manager-api start"
  }
}
